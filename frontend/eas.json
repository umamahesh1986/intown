{
  "cli": {
    "version": ">= 16.28.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "node": "22.23.4",
      "yarn": "1.22.22",
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EAS_BUILD_DISABLE_NPM_CACHE": "1",
        "EXPO_PUBLIC_ENV": "dev",
        "EXPO_PUBLIC_API_BASE_URL": "https://devapi.intownlocal.com",
        "EXPO_PUBLIC_OTP_API_BASE_URL": "https://devapi.intownlocal.com/IN"
      }
    },
    "preview": {
      "node": "22.23.4",
      "yarn": "1.22.22",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EAS_BUILD_DISABLE_NPM_CACHE": "1",
        "EXPO_PUBLIC_ENV": "dev",
        "EXPO_PUBLIC_API_BASE_URL": "https://devapi.intownlocal.com",
        "EXPO_PUBLIC_OTP_API_BASE_URL": "https://devapi.intownlocal.com/IN"
      }
    },
    "production": {
      "node": "22.23.4",
      "yarn": "1.22.22",
      "autoIncrement": true,
      "env": {
        "EAS_BUILD_DISABLE_NPM_CACHE": "1",
        "EXPO_PUBLIC_ENV": "production",
        "EXPO_PUBLIC_API_BASE_URL": "https://api.intownlocal.com",
        "EXPO_PUBLIC_OTP_API_BASE_URL": "https://api.intownlocal.com/IN"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
